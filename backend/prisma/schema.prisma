model Certificate {
  id             String @id @unique @default(uuid())
  weightStartsAt Float
  weightEndsAt   Float
  price          Float

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model DiamondProduct {
  id                     String         @id @unique @default(uuid())
  gemOrigin              GEM_ORIGIN     @default(NATURAL)
  name                   String
  sku                    String
  shape                  String
  weight                 Float
  color                  String
  clarity                String
  cut                    String?
  symmetry               String?
  lab                    String?
  polish                 String?
  certificateNo          String?
  height                 Float?
  width                  Float?
  length                 Float?
  totalDepthInPercentage Float?
  totalWidthInPercentage Float?
  girdle                 String?
  fluorescence           String?
  images                 Json?
  videos                 Json?
  certificateUrl         String?
  source                 DIAMOND_SOURCE @default(MANUAL)

  rap   Float
  price Float

  status       STATUS         @default(ENABLED)
  isDeleted    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  PrimeProduct PrimeProduct[]
  wishlists    Wishlist[]
}

//------------------------------------------ USER ----------------------------------------------------

model User {
  id                    String            @id @unique @default(uuid())
  verficationType       VERIFICATION_TYPE @default(PENDING)
  email                 String
  title                 String?
  companyName           String?
  firstName             String?
  lastName              String?
  countryCode           String?
  mobile                String?
  website               String?
  address               String?
  city                  String?
  postalCode            String?
  country               String?
  companyNumber         String?
  registrationCopyImage String?
  registrationCopyType  REG_TYPE?
  bussinessType         BUSSINESS_TYPE?
  userType              USER_TYPE         @default(USER)

  paymentMode  PAYMENT_MODE? @default(INSTANT)
  paymentCycle Int?
  discount     Float?        @default(0)

  // shippingAddress    String?
  // shippingCity       String?
  // shippingState      String?
  // shippingCountry    String?
  // shippingPostalCode String?

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  password         Password?
  referenceDetails referenceDetails?
  carts            Cart[]
  purchasedOrders  PurchasedOrder[]
  userSession      UserSession[]
  wishlist         Wishlist[]
}

model UserSession {
  id           String  @id @unique @default(uuid())
  user         User?   @relation(fields: [userId], references: [id])
  userId       String?
  authToken    String  @db.Text
  refreshToken String? @db.Text

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model referenceDetails {
  id                String @id @unique @default(uuid())
  user              User   @relation(fields: [userId], references: [id])
  userId            String @unique
  companyName       String
  contactPersonName String
  email             String
  countryCode       String
  mobile            String
  address           String
  city              String
  postalCode        String
  country           String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Password {
  id       String @id @unique @default(uuid())
  user     User   @relation(fields: [userId], references: [id])
  userId   String @unique
  password String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Wishlist {
  id               String          @id @unique @default(uuid())
  user             User            @relation(fields: [userId], references: [id])
  userId           String
  jewellery        Jewellery?      @relation(fields: [jewelleryId], references: [id])
  jewelleryId      String?
  diamondProduct   DiamondProduct? @relation(fields: [diamondProductId], references: [id])
  diamondProductId String?

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Cart {
  id String @id @unique @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  cartItems CartItem[]

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CartItem {
  id String @id @unique @default(uuid())

  cart   Cart   @relation(fields: [cartId], references: [id])
  cartId String

  jewellery   Jewellery        @relation(fields: [jewelleryId], references: [id])
  jewelleryId String
  variant     JewelleryVariant @relation(fields: [variantId], references: [id])
  variantId   String

  quantity Int
  // unitPrice  Float
  // totalPrice Float

  sku                String
  selectedColor      JEWELRY_COLOR
  selectedSize       Float
  material           MATERIAL
  includeCertificate Boolean       @default(false)

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PurchasedOrder {
  id String @id @unique @default(uuid())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  orderNumber String   @unique
  orderDate   DateTime @default(now())

  subtotal    Float
  tax         Float
  shipping    Float
  totalAmount Float

  orderStatus ORDER_STATUS @default(PENDING)

  shippingAddress    String
  shippingCity       String
  shippingState      String
  shippingCountry    String
  shippingPostalCode String

  paymentMethod    PAYMENT_MODE      @default(INSTANT)
  paymentStatus    PAYMENT_STATUS    @default(PENDING)
  razorpayOrderId  String?
  transactionId    String?
  checkoutCurrency CHECKOUT_CURRENCY @default(USD)

  orderItems OrderItem[]

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model OrderItem {
  id String @id @unique @default(uuid())

  order   PurchasedOrder @relation(fields: [orderId], references: [id])
  orderId String

  jewellery   Jewellery        @relation(fields: [jewelleryId], references: [id])
  jewelleryId String
  variant     JewelleryVariant @relation(fields: [variantId], references: [id])
  variantId   String

  sku        String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  selectedColor      JEWELRY_COLOR?
  selectedSize       Float?
  material           MATERIAL
  includeCertificate Boolean        @default(false)

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

//------------------------------------------------------- contact/inquiry ---------------------------------------

model contactUs {
  id           String  @id @unique @default(uuid())
  title        String
  firstName    String
  lastName     String
  email        String
  countryCode  String
  mobile       String
  address      String
  city         String
  postalCode   String
  country      String
  isRegistered Boolean

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model customInquiry {
  id              String  @id @unique @default(uuid())
  inquiresFor     Json
  description     String?
  referenceImages Json?
  referenceLinks  Json?
  title           String?
  firstName       String
  lastName        String?
  email           String
  countryCode     String
  mobile          String
  streetAddress   String?
  city            String
  postalCode      String
  country         String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Event {
  id          String @id @unique @default(uuid())
  title       String
  image       String
  description String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Catelogue {
  id         String @id @unique @default(uuid())
  name       String
  coverImage String
  pdfUrl     String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Location {
  id          String @id @unique @default(uuid())
  country     String
  countryCode String
  phone       String
  email       String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Otp {
  id    String @id @unique @default(uuid())
  email String
  otp   Int

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// One outstanding token per customer; only SHA-256 hashes are stored.
model PasswordResetToken {
  userId    String   @id
  tokenHash String   @unique @db.Char(64)
  expiresAt DateTime
  @@index([expiresAt])
}

// Shared across workers and restarts. Keys contain hashes, never raw emails/IPs.
model PasswordResetRateLimit {
  id        String   @id @db.Char(64)
  count     Int      @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
