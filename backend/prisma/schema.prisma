generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

//------------------------------------------ ENUMS ------------------------------------------------------

enum STATUS {
  ENABLED
  DISABLED
}

enum USER_TYPE {
  USER
  ADMIN
}

enum CATEGPRY_TYPE {
  PRIME_CATEGORY
  NORMAL_CATEGORY
}

enum VERIFICATION_TYPE {
  APPROVE
  REJECT
  PENDING
}

