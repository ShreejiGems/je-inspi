enum JEWELRY_COLOR {
  WHITE
  YELLOW
  ROSE
}

enum REG_TYPE {
  GST
  VAT
  BUSSINESS_REGISTRATION
  BUSSINESS_LICENCE
  OTHER
}

enum PRODUCT_TYPE {
  JEWELLERY
  DIAMOND
}

enum BUSSINESS_TYPE {
  RETAILER
  WHOLESELLER
  MANUFACTURE
}

enum ORDER_STATUS {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PAYMENT_STATUS {
  PENDING
  PAID
  CANCELLED
}

enum GEM_ORIGIN {
  NATURAL
  LAB_GROWN
}

enum MATERIAL {
  SILVER
  TEN_KT_GOLD
  
  FORTEEN_KT_GOLD
  EIGHTEEN_KT_GOLD
}

enum PAYMENT_MODE {
  INSTANT
  PAYMENT_CYCLE
}

enum MEDIA_TYPE {
  IMAGE
  VIDEO
}

enum IMAGE_TYPE {
  HERO_DESKTOP
  HERO_MOBILE
  JEWELLERY_BANNER_DESKTOP
  JEWELLERY_BANNER_MOBILE
  DIAMOND_BANNER_DESKTOP
  DIAMOND_BANNER_MOBILE
  JEWELLERY_VIDEO
  DIAMOND_VIDEO
}

enum DIAMOND_SOURCE {
  MANUAL
  API
}

enum CHECKOUT_CURRENCY {
  INR
  USD
}

//------------------------------------------ MODELS ----------------------------------------------------

model Calculator {
  id                    String @id @unique @default(uuid())
  miscellaneous         Float  @default(0)
  silverPerGram         Float  @default(0)
  tenKtGoldPerGram      Float  @default(0)
  forteenKtGoldPerGram  Float  @default(0)
  eighteenKtGoldPerGram Float  @default(0)
  extraCost             Float  @default(0)
  duty                  Float  @default(0)
  profit                Float  @default(0)
  usRate                Float  @default(0)
  dollarRupeeRate       Float  @default(0)

  filterMin Float?
  filterMax Float?

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model SectionImage {
  id        String     @id @unique @default(uuid())
  image     String
  imageType IMAGE_TYPE
  mediaType MEDIA_TYPE @default(VIDEO)

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

//------------------------------------------ JEWELRY ----------------------------------------------------

model Category {
  id              String        @id @unique @default(uuid())
  name            String        @db.Text
  categoryType    CATEGPRY_TYPE @default(NORMAL_CATEGORY)
  marketingImages Json?

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  subCategory  SubCategory[]
  type         Type[]
  jewellery    Jewellery[]
  primeProduct PrimeProduct[]
}

model SubCategory {
  id         String   @id @unique @default(uuid())
  name       String   @db.Text
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  type      Type[]
  jewellery Jewellery[]
}

model Type {
  id            String      @id @unique @default(uuid())
  name          String      @db.Text
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  subCategoryId String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jewellery Jewellery[]
}

model Collection {
  id   String @id @unique @default(uuid())
  name String @db.Text

  status              STATUS                @default(ENABLED)
  isDeleted           Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt
  jewelleryCollection JewelleryCollection[]
}

model Jewellery {
  id            String      @id @unique @default(uuid())
  name          String      @db.Text
  sku           String
  category      Category    @relation(fields: [categoryId], references: [id])
  categoryId    String
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id])
  subCategoryId String
  type          Type        @relation(fields: [typeId], references: [id])
  typeId        String
  description   String      @db.Text
  images        Json?

  basePrice Float? @default(0)

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  jewelleryVariant    JewelleryVariant[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  jewelleryCollection JewelleryCollection[]
  wishlist            Wishlist[]
  primeProduct        PrimeProduct[]
}

model JewelleryCollection {
  id           String     @id @unique @default(uuid())
  jewellery    Jewellery  @relation(fields: [jewelleryId], references: [id])
  jewelleryId  String
  collection   Collection @relation(fields: [collectionId], references: [id])
  collectionId String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PrimeProduct {
  id               String          @id @unique @default(uuid())
  category         Category?       @relation(fields: [categoryId], references: [id])
  categoryId       String?
  jewellery        Jewellery?      @relation(fields: [jewelleryId], references: [id])
  jewelleryId      String?
  diamondProduct   DiamondProduct? @relation(fields: [diamondProductId], references: [id])
  diamondProductId String?
  productType      PRODUCT_TYPE
  primeImage       String

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model JewelleryVariant {
  id             String      @id @unique @default(uuid())
  jewellery      Jewellery   @relation(fields: [jewelleryId], references: [id])
  jewelleryId    String
  gemOrigin      GEM_ORIGIN?
  hasGems        Boolean     @default(false)
  size           Int         @default(0)
  silver         Float?      @default(0)
  tenKtGold      Float?      @default(0)
  forteenKtGold  Float?      @default(0)
  eighteenKtGold Float?      @default(0)
  mesurement     Json?

  basePrice      Float? @default(0)
  totalGemWeight Float?

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  gem        Gem[]
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model Gem {
  id        String           @id @unique @default(uuid())
  variant   JewelleryVariant @relation(fields: [variantId], references: [id])
  variantId String
  shape     String
  mm        String
  weight    Float
  color     String
  clarity   String
  quantity  Int

  status    STATUS   @default(ENABLED)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

