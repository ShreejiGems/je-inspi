{
  "name": "je-inspi-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "db:start": "node ../scripts/local-mysql.cjs start",
    "db:stop": "node ../scripts/local-mysql.cjs stop",
    "db:status": "node ../scripts/local-mysql.cjs status",
    "db:studio": "node scripts/with-env.cjs node_modules/prisma/build/index.js studio --hostname 127.0.0.1 --port 5555 --browser none",
    "db:hosted:check": "node scripts/with-env.cjs --env-file .env.hosted.local scripts/check-database.cjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node scripts/with-env.cjs node_modules/@nestjs/cli/bin/nest.js start",
    "start:dev": "node scripts/with-env.cjs node_modules/@nestjs/cli/bin/nest.js start --watch",
    "start:debug": "node scripts/with-env.cjs node_modules/@nestjs/cli/bin/nest.js start --debug --watch",
    "start:prod": "node scripts/with-env.cjs dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma-all": "npx prisma format && npx prisma generate && npx prisma db push",
    "cron-diamond-price": "node scripts/with-env.cjs -r ts-node/register -r tsconfig-paths/register src/cli.ts cronJob:fetchDiamondPrice",
    "cron-lab-diamond-price": "node scripts/with-env.cjs -r ts-node/register -r tsconfig-paths/register src/cli.ts cronJob:fetchLabDiamondPrice",
    "cron-delete-otp": "node scripts/with-env.cjs -r ts-node/register -r tsconfig-paths/register src/cli.ts cronJob:deleteOtp",
    "cron-currency-conversion": "node scripts/with-env.cjs -r ts-node/register -r tsconfig-paths/register src/cli.ts cronJob:currencyConversion",
    "cron-recalculate-price": "node scripts/with-env.cjs -r ts-node/register -r tsconfig-paths/register src/cli.ts cronJob:recalculatePrice"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "6.13.0",
    "@types/xlsx": "^0.0.36",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "crypto": "^1.0.1",
    "luxon": "^3.7.1",
    "mailgun.js": "^12.1.1",
    "nestjs-command": "^3.1.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "6.13.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
