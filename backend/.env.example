PORT=1631
ENV=DEVELOPMENT
CORS_ORIGINS=http://localhost:4001,http://localhost:4002

# Provision a separate JE-Inspi database before using this value.
DATABASE_URL=mysql://je_inspi_user:CHANGE_ME@127.0.0.1:3306/je_inspi

# Configure only with JE-Inspi credentials and storage accounts.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=
BASE_URL=http://localhost:4002
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
CONTACT_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=
GLOWSTAR_USER=
GLOWSTAR_PASSWORD=
GLOWSTAR_API=
DHARMATECH_API_KEY=
DHARMATECH_API=
EXCHANGERATE_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret

# Fixed trusted URL; never derived from request headers.
PASSWORD_RESET_URL=http://localhost:4002/reset-password
