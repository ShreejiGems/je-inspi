PORT=1631
HOST=127.0.0.1
ENV=PRODUCTION
NODE_ENV=production
CORS_ORIGINS=https://shop.je-inspi.example,https://admin.je-inspi.example
BASE_URL=https://shop.je-inspi.example

# Replace user, password and hostname with the managed database details.
# URL-encode special characters in the username/password. Download the cluster CA certificate.
DATABASE_URL="mysql://je_inspi_user:CHANGE_ME@YOUR_CLUSTER.db.ondigitalocean.com:25060/je_inspi?sslcert=/etc/je-inspi/mysql-ca.crt&sslaccept=strict&connection_limit=5&pool_timeout=20"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAIL_FROM=
CONTACT_EMAIL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_SECRET=
GLOWSTAR_USER=
GLOWSTAR_PASSWORD=
GLOWSTAR_API=
DHARMATECH_API_KEY=
DHARMATECH_API=
EXCHANGERATE_API_KEY=

# Fixed trusted URL; never derived from request headers.
PASSWORD_RESET_URL=https://shop.je-inspi.example/reset-password
TRUST_PROXY_LOOPBACK=true
JWT_SECRET=replace-with-a-long-random-production-secret
